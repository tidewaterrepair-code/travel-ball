# Your domain (DNS A record must point at this VPS), e.g. app.yourdomain.com
DOMAIN=app.example.com
# Email for Let's Encrypt certificate notices
EMAIL=you@example.com

# Who can open /admin (create clubs, see every club). Comma-separated.
ADMIN_EMAILS=you@example.com

# Optional: real email delivery for sign-in links and invites (https://resend.com, free tier).
# Without it, the app shows sign-in links for you to copy and text.
RESEND_API_KEY=
EMAIL_FROM=Dugout HQ <hello@yourdomain.com>

# Website lookups allowed per visitor per minute
BRAND_RATE_LIMIT=20
